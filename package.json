{
  "name": "cctp-bridge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "prelint": "bun run scripts/ensure-generated-metadata.ts",
    "prebuild": "bun run metadata:refresh",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "metadata:generate": "bun run scripts/generate-cctp-metadata.ts",
    "rpc:generate": "bun run scripts/generate-rpc-candidates.ts",
    "metadata:refresh": "bun run metadata:generate && bun run rpc:generate",
    "prepare": "husky"
  },
  "dependencies": {
    "@circle-fin/bridge-kit": "^1.8.2",
    "@coral-xyz/anchor": "^0.32.1",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toast": "^1.2.15",
    "@rainbow-me/rainbowkit": "^2.2.10",
    "@solana/spl-token": "^0.4.14",
    "@solana/wallet-adapter-base": "^0.9.27",
    "@solana/wallet-adapter-react": "^0.15.39",
    "@solana/wallet-adapter-react-ui": "^0.9.39",
    "@solana/wallet-adapter-wallets": "^0.19.37",
    "@solana/web3.js": "^1.98.4",
    "@tailwindcss/postcss": "^4.1.18",
    "@tanstack/react-query": "^5.90.16",
    "@types/node": "^25.0.9",
    "@types/react": "19.1.7",
    "@types/react-dom": "19.1.6",
    "@vercel/analytics": "^1.6.1",
    "@web3icons/react": "^4.1.17",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "9.28.0",
    "eslint-config-next": "^16.1.1",
    "lucide-react": "^0.562.0",
    "next": "^16.1.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "5.8.3",
    "viem": "^2.46.2",
    "wagmi": "2.19.5",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.6",
    "vercel": "^50.18.2",
    "vitest": "^4.0.17"
  }
}
