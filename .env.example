# WalletConnect Project ID (Required)
# Get yours at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# Bridge Kit Environment (Required)
# Options: mainnet, testnet
NEXT_PUBLIC_BRIDGEKIT_ENV=testnet

# Optional: Custom Integrator Fee (in USDC)
# NEXT_PUBLIC_BRIDGEKIT_CUSTOM_FEE=0.001

# Optional: Fee Recipient Address (required if custom fee is set)
# NEXT_PUBLIC_BRIDGEKIT_CUSTOM_FEE_RECIPIENT=0x...
