# WalletConnect Project ID (Required)
# Get yours at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# Bridge Kit Environment (Required)
# Options: mainnet, testnet
NEXT_PUBLIC_BRIDGEKIT_ENV=testnet

# First-party bridge statistics database (server-only; never expose to the client)
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=...

# Optional: Fast tx app fee. Enabled only when all three values are valid.
# NEXT_PUBLIC_FAST_TX_FEE_BPS=4
# NEXT_PUBLIC_FEE_ADDRESS_EVM=0x...
# NEXT_PUBLIC_FEE_ADDRESS_SOL=...

# Development only: skip the client-side USDC balance validation for UI smoke tests.
# NEXT_PUBLIC_DISABLE_BALANCE_CHECK=1

# Optional: EVM fork integration tests.
# EVM_FORK_ETH_RPC_URL=https://...
# EVM_FORK_ARB_RPC_URL=https://...
